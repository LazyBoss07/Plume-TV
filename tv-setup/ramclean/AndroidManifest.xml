<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="tv.ramclean"
    android:versionCode="3"
    android:versionName="3.0">

    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Last-used times for the list; granted with: adb shell appops set tv.ramclean GET_USAGE_STATS allow -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="RAM Clean"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false">
        <!-- No app tile: Plume opens this from the RAM pill on its Home screen. -->
        <activity
            android:name=".CleanActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <!-- Presses Force stop and OK in Settings for each app being closed. -->
        <service
            android:name=".Helper"
            android:label="RAM Clean helper"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/helper" />
        </service>
    </application>
</manifest>
